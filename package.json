{
  "name": "oficiossincelejo",
  "version": "1.1.0",
  "private": true,
  "description": "Directorio web de trabajadores independientes de oficios varios en Sincelejo (PWA con Firebase).",
  "license": "MIT",
  "scripts": {
    "servir": "node scripts/servir.js",
    "test:e2e": "node tests/e2e.js",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-oficios \"node --test tests/reglas.test.mjs\"",
    "test": "npm run test:e2e && npm run test:reglas",
    "reglas:publicar": "firebase deploy --only firestore:rules",
    "respaldo": "node scripts/respaldo.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-admin": "14.5.1",
    "firebase-tools": "13.35.1",
    "playwright": "1.63.0"
  },
  "engines": { "node": ">=20" }
}
